<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to root domain /
  RewriteRule ^index\.html$ / [R=301,L]

  # Serve post.html for /blog/slug/ or /blog/slug requests (if served via Apache)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog/post.html?slug=$1 [L,QSA]
</IfModule>
