    /* VALUES */
    .sec-val{padding:90px 80px;background:#f8f9fb;border-top:1px solid rgba(0,0,0,.06);border-bottom:1px solid rgba(0,0,0,.06);}
    .val-head{max-width:640px;margin-bottom:52px;}
    .val-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
    .val-card{background:#fff;border:1px solid rgba(37,99,255,.08);border-radius:20px;padding:32px;transition:all .35s cubic-bezier(.16,1,.3,1);}
