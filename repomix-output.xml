    .breadcrumb a{color:rgba(255,255,255,.72);transition:color .2s;}
    .breadcrumb a:hover{color:#fff;}
    .breadcrumb .sep{color:rgba(255,255,255,.35);}
    .breadcrumb .current{color:#fff;font-weight:600;}

    /* HERO */
    .ind-hero{min-height:540px;padding:180px 80px 100px;position:relative;overflow:hidden;display:flex;align-items:flex-end;}
    .ind-hero-bg{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80');background-size:cover;background-position:center;}
    .ind-hero-overlay{position:absolute;inset:0;background:linear-gradient(150deg,rgba(6,6,18,.92) 0%,rgba(37,99,255,.5) 100%);}
