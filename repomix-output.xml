<div class="login" id="login">
  <div class="login-card">
    <img src="./logo/Tech DataSeeders Logo.png" alt="Techdataseeders">
    <h1>Blog Admin</h1>
    <p>Enter your credentials to manage blog posts.</p>
    <div class="login-err" id="loginErr"></div>
    <input type="text" id="username" placeholder="Username" autocomplete="username">
    <input type="password" id="pw" placeholder="Password" autocomplete="current-password">
    <button class="btn btn-primary" id="loginBtn">Sign in →</button>
  </div>
</div>

<!-- APP -->
<div id="app" style="display:none;">
  <div class="top">
    <div class="top-l">
      <a href="./index.html" class="top-logo"><img src="./logo/Tech DataSeeders Logo.png" alt="Techdataseeders"></a>
      <span class="top-badge">Blog Admin</span>
    </div>
    <div class="top-r">
      <button class="btn" id="refreshBtn"><svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>Refresh</button>
      <button class="btn btn-primary" id="newBtn"><svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>New Post</button>
      <button class="btn btn-danger" id="logoutBtn">Logout</button>
    </div>
  </div>

  <div class="wrap">
    <div class="note">
     All changes are saved directly to the database.
      Posts are automatically available on the live site. No manual file uploads needed.
    </div>
    <div class="count" id="count"></div>
    <div class="plist" id="plist"></div>
  </div>
</div>

<!-- EDITOR MODAL -->
<div class="overlay" id="overlay">
  <div class="modal">
    <div class="modal-head">
      <h2 id="modalTitle">New Post</h2>
      <button class="x" id="closeBtn"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="f-orig">
      <div class="field">
        <label>Title *</label>
        <input type="text" id="f-title" placeholder="e.g. How We Cut Scraping Costs by 40%">
      </div>
      <div class="grid2">
        <div class="field">
          <label>URL slug *</label>
          <input type="text" id="f-slug" placeholder="how-we-cut-costs">
          <div class="hint">Lowercase, words separated by dashes. Auto-filled from the title.</div>
        </div>
        <div class="field">
          <label>Category</label>
          <input type="text" id="f-category" placeholder="Web Scraping">
        </div>
      </div>
      <div class="grid2">
        <div class="field"><label>Author</label><input type="text" id="f-author" placeholder="Your name"></div>
        <div class="field"><label>Date</label><input type="text" id="f-date" placeholder="May 18, 2026"></div>
      </div>
      <div class="grid2">
        <div class="field"><label>Read time</label><input type="text" id="f-read" placeholder="6 min read"></div>
        <div class="field"><label>Tags (comma separated)</label><input type="text" id="f-tags" placeholder="Web Scraping, Tips"></div>
      </div>
      <div class="field">
        <label>Short summary (excerpt)</label>
        <input type="text" id="f-excerpt" placeholder="One or two lines shown on cards and at the top of the post.">
      </div>
      <div class="field">
        <label>Hero image URL</label>
        <input type="text" id="f-hero" placeholder="https://… (leave blank for none)">
      </div>
      <div class="grid2">
        <div class="field">
          <label>Card color</label>
          <select id="f-gradient"></select>
          <div class="swatch" id="gradSwatch"></div>
        </div>
        <div class="field">
          <label>Card icon</label>
          <select id="f-icon"></select>
        </div>
      </div>
      <div class="field">
        <label>Article content</label>
        <textarea id="f-body" placeholder="Write your article here…"></textarea>
        <div class="hint">
          Formatting: start a line with <strong>## </strong> for a heading, <strong>### </strong> for a sub-heading,
          <strong>&gt; </strong> for a highlighted quote, <strong>- </strong> for a bullet point.
          Wrap text in <strong>**double stars**</strong> for bold. Leave a blank line between paragraphs.
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <span class="err" id="formErr"></span>
      <button class="btn" id="cancelBtn">Cancel</button>
      <button class="btn btn-primary" id="saveBtn">Save Post</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function(){
  /* ====== CONFIG ====== */
  const API_URL = window.location.origin + '/api';
  let authToken = localStorage.getItem('admin_token') || null;
  let posts = [];

  /* ====== TOAST ====== */
  var toastT;
  function toast(msg){
    var t=document.getElementById('toast'); 
    t.textContent=msg; 
    t.classList.add('show');
    clearTimeout(toastT); 
    toastT=setTimeout(function(){t.classList.remove('show');},3000);
  }

  /* ====== API HELPERS ====== */
  async function apiRequest(endpoint, options = {}) {
    const headers = {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      ...options.headers
    };
    
    if (authToken) {
      headers['Authorization'] = 'Bearer ' + authToken;
    }
    
    const response = await fetch(API_URL + endpoint, {
      ...options,
      headers
    });
    
    const data = await response.json();
    
    if (!response.ok) {
      throw new Error(data.message || 'API request failed');
    }
    
    return data;
  }

  async function fetchPosts() {
    try {
      const data = await apiRequest('/blog');
      return data.data || [];
    } catch (error) {
      console.error('Error fetching posts:', error);
      toast('❌ Failed to load posts');
      return [];
    }
  }

  async function savePostToAPI(post) {
    try {
      const data = await apiRequest('/blog', {
        method: 'POST',
        body: JSON.stringify(post)
      });
      return data.data;
    } catch (error) {
      console.error('Error saving post:', error);
      throw error;
    }
  }

  async function deletePostFromAPI(slug) {
    try {
      await apiRequest('/blog/' + slug, {
        method: 'DELETE'
      });
      return true;
    } catch (error) {
      console.error('Error deleting post:', error);
      throw error;
    }
  }

  /* ====== LOGIN ====== */
  var loginEl = document.getElementById('login'), appEl = document.getElementById('app');
  
  async function verifyToken() {
    if (!authToken) return false;
    try {
      await apiRequest('/blog');
      return true;
    } catch (error) {
      localStorage.removeItem('admin_token');
      authToken = null;
      return false;
    }
  }

  async function showApp() {
    loginEl.style.display = 'none';
    appEl.style.display = 'block';
    await loadPosts();
  }

  // Check if already logged in
  (async function checkAuth() {
    if (authToken) {
      const valid = await verifyToken();
      if (valid) {
        showApp();
        return;
      }
    }
    // Show login
    loginEl.style.display = 'flex';
    appEl.style.display = 'none';
  })();

  async function tryLogin() {
    var username = document.getElementById('username').value.trim();
    var password = document.getElementById('pw').value;
    var errEl = document.getElementById('loginErr');
    
    if (!username || !password) {
      errEl.textContent = 'Please enter both username and password';
      return;
    }
    
    // Disable button to prevent multiple submissions
    var btn = document.getElementById('loginBtn');
    btn.disabled = true;
    btn.textContent = 'Signing in…';
    
    try {
      const data = await apiRequest('/auth/login', {
        method: 'POST',
        body: JSON.stringify({ username, password })
      });
      
      if (data.success) {
        authToken = data.token;
        localStorage.setItem('admin_token', authToken);
        errEl.textContent = '';
        showApp();
      } else {
        errEl.textContent = data.message || 'Invalid credentials';
        btn.disabled = false;
        btn.textContent = 'Sign in →';
      }
    } catch (error) {
      errEl.textContent = 'Network error. Please try again.';
      console.error('Login error:', error);
      btn.disabled = false;
      btn.textContent = 'Sign in →';
    }
  }

  document.getElementById('loginBtn').addEventListener('click', tryLogin);
  document.getElementById('pw').addEventListener('keydown', function(e){ 
    if(e.key==='Enter') tryLogin(); 
  });
  document.getElementById('username').addEventListener('keydown', function(e){ 
    if(e.key==='Enter') tryLogin(); 
  });

  document.getElementById('logoutBtn').addEventListener('click', function(){
    localStorage.removeItem('admin_token');
    authToken = null;
    location.reload();
  });

  /* ====== POST MANAGEMENT ====== */
  var plist = document.getElementById('plist');

  async function loadPosts() {
    posts = await fetchPosts();
    render();
  }

  function render() {
    document.getElementById('count').textContent = posts.length + (posts.length===1?' post':' posts');
    if(!posts.length){ 
      plist.innerHTML='<div class="empty">No posts yet. Click “New Post” to create one.</div>'; 
      return; 
    }
    plist.innerHTML = posts.map(function(p, i){
      // Use the BlogStore functions if available
      var gradient = window.BlogStore ? BlogStore.gradientOf(p) : 'linear-gradient(135deg,#2563FF,#1a4fd8)';
      var icon = window.BlogStore ? BlogStore.iconOf(p) : '<circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="12"/>';
      var escapedTitle = String(p.title || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var escapedCategory = String(p.category || ' ').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var escapedAuthor = String(p.author || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var escapedDate = String(p.date || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var escapedSlug = String(p.slug || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      
      return '<div class="pitem">'+
        '<div class="pthumb" style="background:'+gradient+'"><svg viewBox="0 0 24 24">'+icon+'</svg></div>'+
        '<div class="pmeta">'+
          '<div class="pcat">'+escapedCategory+'</div>'+
          '<div class="ptitle">'+escapedTitle+'</div>'+
          '<div class="psub">'+escapedAuthor+(p.date?' • '+escapedDate:'')+' • '+escapedSlug+'</div>'+
        '</div>'+
        '<div class="pacts">'+
          '<a class="btn" target="_blank" href="./blog/post.html?slug='+encodeURIComponent(p.slug)+'">View</a>'+
          '<button class="btn" data-edit="'+i+'">Edit</button>'+
          '<button class="btn btn-danger" data-del="'+i+'">Delete</button>'+
        '</div>'+
      '</div>';
    }).join('');
  }

  plist.addEventListener('click', function(e){
    var ed = e.target.getAttribute('data-edit');
    var dl = e.target.getAttribute('data-del');
    if(ed!==null && ed!==undefined) openEditor(parseInt(ed));
    if(dl!==null && dl!==undefined){
      var p = posts[parseInt(dl)];
      if(confirm('Delete “'+p.title+'”? This cannot be undone.')){
        deletePostFromAPI(p.slug).then(function() {
          posts.splice(parseInt(dl), 1);
          render();
          toast('✅ Post deleted');
        }).catch(function(err) {
          toast('❌ Failed to delete: ' + err.message);
        });
      }
    }
  });

  /* ====== EDITOR ====== */
  var overlay = document.getElementById('overlay');

  function openEditor(index){
    var p = (index!=null) ? posts[index] : {gradient:'blue', icon:'database'};
    document.getElementById('modalTitle').textContent = (index!=null)?'Edit Post':'New Post';
    document.getElementById('f-orig').value = (index!=null)? p.slug : '';
    document.getElementById('f-title').value = p.title||'';
    document.getElementById('f-slug').value = p.slug||'';
    document.getElementById('f-category').value = p.category||'';
    document.getElementById('f-author').value = p.author||'';
    document.getElementById('f-date').value = p.date||'';
    document.getElementById('f-read').value = p.readTime||'';
    document.getElementById('f-tags').value = (p.tags||[]).join(', ');
    document.getElementById('f-excerpt').value = p.excerpt||'';
    document.getElementById('f-hero').value = p.heroImage||'';
    document.getElementById('f-gradient').value = p.gradient||'blue';
    document.getElementById('f-icon').value = p.icon||'database';
    document.getElementById('f-body').value = p.body||'';
    document.getElementById('formErr').textContent = '';
    updateSwatch();
    overlay.classList.add('show');
  }

  function closeEditor(){ 
    overlay.classList.remove('show'); 
  }

  function updateSwatch(){
    var grad = document.getElementById('f-gradient').value;
    var gradients = {
      blue: 'linear-gradient(135deg,#0d1b4b 0%,#1a4fd6 50%,#2563FF 100%)',
      green: 'linear-gradient(135deg,#064e3b 0%,#059669 50%,#10b981 100%)',
      purple: 'linear-gradient(135deg,#2e1065 0%,#5b21b6 50%,#7c3aed 100%)',
      magenta: 'linear-gradient(135deg,#4d1a3d 0%,#9d4edd 50%,#c77dff 100%)',
      teal: 'linear-gradient(135deg,#1a4d3d 0%,#2d9d6e 50%,#52b788 100%)',
      navy: 'linear-gradient(135deg,#0d1840 0%,#162050 60%,#2563FF 100%)'
    };
    document.getElementById('gradSwatch').style.background = gradients[grad] || gradients.blue;
  }

  // auto-slug from title
  function slugify(s) {
    return String(s || '').toLowerCase().trim()
      .replace(/['"]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 70);
  }

  document.getElementById('f-title').addEventListener('input', function(){
    var slugField = document.getElementById('f-slug');
    if(!document.getElementById('f-orig').value && (!slugField.dataset.touched)){
      slugField.value = slugify(this.value);
    }
  });
  document.getElementById('f-slug').addEventListener('input', function(){ 
    this.dataset.touched = '1'; 
  });

 document.getElementById('saveBtn').addEventListener('click', async function(){
  var title = document.getElementById('f-title').value.trim();
  var slug = slugify(document.getElementById('f-slug').value || title);
  var origSlug = document.getElementById('f-orig').value; // This is the original slug
  var err = document.getElementById('formErr');
  
  if(!title){ err.textContent='Title is required.'; return; }
  if(!slug){ err.textContent='A valid URL slug is required.'; return; }
  
  // Check for duplicate slug - EXCLUDE the current post when editing
  var clash = posts.some(function(p){ 
    // If we're editing (origSlug exists), skip the current post
    if (origSlug && p.slug === origSlug) {
      return false; // Skip the current post
    }
    // Check if any OTHER post has this slug
    return p.slug === slug; 
  });
  
  if(clash){ 
    err.textContent='Another post already uses that slug. Choose a different one.'; 
    return; 
  }

  var tags = document.getElementById('f-tags').value.split(',').map(function(t){return t.trim();}).filter(Boolean);
  
  // Build the post object
  var obj = {
    title: title,
    slug: slug,
    category: document.getElementById('f-category').value.trim(),
    author: document.getElementById('f-author').value.trim(),
    date: document.getElementById('f-date').value.trim(),
    readTime: document.getElementById('f-read').value.trim(),
    excerpt: document.getElementById('f-excerpt').value.trim(),
    heroImage: document.getElementById('f-hero').value.trim(),
    gradient: document.getElementById('f-gradient').value,
    icon: document.getElementById('f-icon').value,
    tags: tags,
    body: document.getElementById('f-body').value
  };

  // If editing, include the _id so the backend knows it's an update
  if (origSlug) {
    var existing = posts.find(function(p) { return p.slug === origSlug; });
    if (existing && existing._id) {
      obj._id = existing._id;
      // Keep the original slug in a separate field for the backend to identify the post
      obj.originalSlug = origSlug;
    }
  }

  console.log('📝 Saving post:', { 
    title: obj.title, 
    slug: obj.slug, 
    origSlug: origSlug,
    isEdit: !!origSlug,
    hasId: !!obj._id
  });

  try {
    const saved = await savePostToAPI(obj);
    if(origSlug){
      var idx = posts.findIndex(function(p){ return p.slug === origSlug; });
      if(idx > -1) {
        posts[idx] = saved;
      } else {
        posts.unshift(saved);
      }
    } else {
      posts.unshift(saved);
    }
    render();
    closeEditor();
    toast('✅ Post saved to database');
  } catch(error) {
    err.textContent = 'Failed to save: ' + error.message;
    toast('❌ Error saving post');
    console.error('Save error:', error);
  }
});
  document.getElementById('newBtn').addEventListener('click', function(){
    document.getElementById('f-slug').dataset.touched = '';
    document.getElementById('f-orig').value = '';
    openEditor(null);
  });
  document.getElementById('closeBtn').addEventListener('click', closeEditor);
  document.getElementById('cancelBtn').addEventListener('click', closeEditor);
  overlay.addEventListener('click', function(e){ if(e.target===overlay) closeEditor(); });

  /* ====== INIT SELECTS ====== */
  (function initSelects() {
    var g = document.getElementById('f-gradient');
    var gradients = {
      blue: 'Blue',
      green: 'Green',
      purple: 'Purple',
      magenta: 'Magenta',
      teal: 'Teal',
      navy: 'Navy'
    };
    Object.keys(gradients).forEach(function(k){ 
      var o = document.createElement('option'); 
      o.value = k; 
      o.textContent = gradients[k]; 
      g.appendChild(o); 
    });
    
    var ic = document.getElementById('f-icon');
    var icons = {
      database: 'Database',
      activity: 'Activity',
      shield: 'Shield',
      clock: 'Clock',
      chart: 'Chart',
      doc: 'Document',
      globe: 'Globe',
      star: 'Star',
      bulb: 'Bulb'
    };
    Object.keys(icons).forEach(function(k){ 
      var o = document.createElement('option'); 
      o.value = k; 
      o.textContent = icons[k]; 
      ic.appendChild(o); 
    });
    
    g.addEventListener('change', updateSwatch);
  })();

  /* ====== REFRESH ====== */
  document.getElementById('refreshBtn').addEventListener('click', function(){
    loadPosts().then(function() {
      toast('🔄 Posts refreshed');
    });
  });

})();
</script>
</body>
</html>
