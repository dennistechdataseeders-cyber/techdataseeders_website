  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@0,400;0,600;0,700;0,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{--blue:#2563FF;--blue-dark:#1a4fd8;--black:#0a0a0a;--font-d:'Plus Jakarta Sans',sans-serif;--font-b:'Inter',sans-serif;--line:rgba(0,0,0,.09);}
    body{font-family:var(--font-b);background:#f4f6fb;color:#0a0a0a;-webkit-font-smoothing:antialiased;}
    a{color:var(--blue);text-decoration:none;}
    button{font-family:var(--font-b);cursor:pointer;}

    /* top bar */
    .top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 28px;background:#fff;border-bottom:1px solid var(--line);flex-wrap:wrap;}
    .top-l{display:flex;align-items:center;gap:14px;}
    .top-logo img{height:28px;display:block;}
    .top-badge{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);background:rgba(37,99,255,.1);padding:5px 12px;border-radius:100px;}
    .top-r{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .btn{border:1px solid var(--line);background:#fff;color:#333;padding:10px 16px;border-radius:10px;font-size:13.5px;font-weight:600;display:inline-flex;align-items:center;gap:8px;transition:all .2s;}
    .btn:hover{border-color:var(--blue);color:var(--blue);}
    .btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
    .btn-primary{background:var(--blue);border-color:var(--blue);color:#fff;}
    .btn-primary:hover{background:var(--blue-dark);color:#fff;}
    .btn-pub{background:#059669;border-color:#059669;color:#fff;}
    .btn-pub:hover{background:#047857;color:#fff;}
    .btn-danger{color:#dc2626;}
    .btn-danger:hover{border-color:#dc2626;color:#dc2626;}

    .wrap{max-width:1080px;margin:0 auto;padding:28px 28px 80px;}
    .note{background:#eef3ff;border:1px solid rgba(37,99,255,.2);border-radius:14px;padding:16px 20px;font-size:13.5px;line-height:1.7;color:#33415c;margin-bottom:24px;}
    .note strong{color:#1a2b50;}
    .count{font-family:var(--font-d);font-size:18px;font-weight:700;margin-bottom:16px;}

    /* post list */
    .plist{display:flex;flex-direction:column;gap:12px;}
    .pitem{display:flex;align-items:center;gap:18px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 18px;transition:box-shadow .2s;}
    .pitem:hover{box-shadow:0 8px 26px rgba(0,0,0,.06);}
    .pthumb{width:58px;height:58px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
    .pthumb svg{width:24px;height:24px;stroke:#fff;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
    .pmeta{flex:1;min-width:0;}
    .pmeta .pcat{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);}
    .pmeta .ptitle{font-family:var(--font-d);font-size:16px;font-weight:700;line-height:1.3;margin:3px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .pmeta .psub{font-size:12px;color:#888;}
    .pacts{display:flex;gap:8px;flex-shrink:0;}
    .empty{text-align:center;color:#999;padding:60px 0;}

    /* editor modal */
    .overlay{position:fixed;inset:0;background:rgba(10,14,30,.55);backdrop-filter:blur(3px);z-index:50;display:none;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto;}
    .overlay.show{display:flex;}
    .modal{background:#fff;border-radius:22px;width:100%;max-width:760px;box-shadow:0 30px 80px rgba(0,0,0,.3);}
    .modal-head{display:flex;align-items:center;justify-content:space-between;padding:22px 28px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;border-radius:22px 22px 0 0;z-index:2;}
    .modal-head h2{font-family:var(--font-d);font-size:19px;font-weight:700;}
    .x{width:34px;height:40px;border-radius:9px;border:1px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:center;}
    .x svg{width:16px;height:16px;stroke:#555;fill:none;stroke-width:2;stroke-linecap:round;}
    .modal-body{padding:24px 28px;}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .field{margin-bottom:16px;}
    .field label{display:block;font-size:12.5px;font-weight:600;color:#444;margin-bottom:7px;}
    .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px 13px;font-size:14px;font-family:var(--font-b);color:#1a1a1a;background:#fff;transition:border .2s;}
    .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--blue);}
    .field textarea{resize:vertical;min-height:200px;line-height:1.6;}
    .hint{font-size:11.5px;color:#999;margin-top:6px;line-height:1.6;}
    .swatch{height:38px;border-radius:10px;margin-top:8px;border:1px solid var(--line);}
    .modal-foot{display:flex;align-items:center;justify-content:flex-end;gap:10px;padding:18px 28px;border-top:1px solid var(--line);position:sticky;bottom:0;background:#fff;border-radius:0 0 22px 22px;}
    .err{color:#dc2626;font-size:13px;margin-right:auto;}

    /* login */
    .login{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#f4f6fb;}
    .login-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:40px;width:100%;max-width:380px;box-shadow:0 24px 60px rgba(0,0,0,.08);text-align:center;}
    .login-card img{height:40px;margin-bottom:24px;}
    .login-card h1{font-family:var(--font-d);font-size:22px;font-weight:800;margin-bottom:8px;}
    .login-card p{font-size:13.5px;color:#777;margin-bottom:24px;}
    .login-card input{width:100%;border:1px solid var(--line);border-radius:11px;padding:13px 15px;font-size:15px;margin-bottom:14px;font-family:var(--font-b);}
    .login-card input:focus{outline:none;border-color:var(--blue);}
    .login-card .btn-primary{width:100%;justify-content:center;padding:13px;}
    .login-err{color:#dc2626;font-size:13px;margin-bottom:12px;min-height:18px;}

    .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#0a0a0a;color:#fff;padding:13px 22px;border-radius:100px;font-size:13.5px;font-weight:600;opacity:0;pointer-events:none;transition:all .3s;z-index:100;}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    @media(max-width:600px){.grid2{grid-template-columns:1fr;}.top{padding:12px 16px;}.wrap{padding:20px 16px 70px;}}
  </style>
