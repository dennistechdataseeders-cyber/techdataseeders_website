<script>
  const cd = document.getElementById('cd'), cr = document.getElementById('cr');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    cd.style.left = mx + 'px'; cd.style.top = my + 'px';
  });
  (function loop() {
    rx += (mx - rx) * .12; ry += (my - ry) * .12;
    cr.style.left = rx + 'px'; cr.style.top = ry + 'px';
    requestAnimationFrame(loop);
  })();
  document.querySelectorAll('a,button').forEach(el => {
    el.addEventListener('mouseenter', () => { cd.style.width = cd.style.height = '12px'; cr.style.width = cr.style.height = '52px'; cr.style.opacity = '.45'; });
    el.addEventListener('mouseleave', () => { cd.style.width = cd.style.height = '8px'; cr.style.width = cr.style.height = '36px'; cr.style.opacity = '1'; });
  });
  const nav = document.getElementById('nav'), navLogo = document.getElementById('navLogo');
  const stb = document.getElementById('stb');
  window.addEventListener('scroll', () => {
    const s = window.scrollY;
    nav.classList.toggle('dark', s > 80);
    navLogo.src = s > 80 ? '../logo/TDS Logo Set/Tech DataSeeders Logo white.png' : '../logo/Tech DataSeeders Logo.png';
    stb.classList.toggle('on', s > 400);
  });
  const navToggle = document.getElementById('navToggle');
  if (navToggle) {
    navToggle.addEventListener('click', () => {
      const open = nav.classList.toggle('nav-open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (!open) document.querySelectorAll('.has-drop').forEach(i => i.classList.remove('open'));
    });
    nav.querySelectorAll('.nl a').forEach(a => {
      if (a.parentElement.classList.contains('has-drop')) return;
      a.addEventListener('click', () => { nav.classList.remove('nav-open'); navToggle.setAttribute('aria-expanded','false'); });
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) { nav.classList.remove('nav-open'); navToggle.setAttribute('aria-expanded','false'); }
    });
  }
  (function () {
    var drops = nav.querySelectorAll('.nl .has-drop');
    function closeDrops(except) {
      drops.forEach(function (li) { if (li !== except) li.classList.remove('open'); });
    }
    drops.forEach(function (li) {
      var link = li.querySelector(':scope > a');
      link.addEventListener('click', function (e) {
        e.preventDefault();
        var willOpen = !li.classList.contains('open');
        closeDrops(li);
        li.classList.toggle('open', willOpen);
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.has-drop')) closeDrops(null);
    });
  })();
</script>
