    }

    /* SECTIONS */
    .sec {
      padding: 100px 80px;
    }

    .sec-dark {
      background: var(--black);
      color: #fff;
    }

    .sec-navy {
      background: var(--navy);
      color: #fff;
    }

    .sec-light {
      background: #fff;
    }

    .sec-soft {
      background: #f8f9ff;
    }

    .sec-grey {
      background: #f7f7f7;
    }

    .lbl {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 14px;
    }

    .sec-dark .lbl,
    .sec-navy .lbl {
      color: var(--blue-light);
    }

    .stitle {
      font-family: var(--font-d);
      font-size: clamp(34px, 4vw, 56px);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -.025em;
      margin-bottom: 18px;
    }

    .stitle .it {
      font-style: italic;
      font-weight: 800;
    }

    .ssub {
      font-size: 16px;
      line-height: 1.7;
      color: #666;
      max-width: 500px;
    }

    .sec-dark .ssub,
    .sec-navy .ssub {
      color: rgba(255, 255, 255, .45);
    }

    /* REVEAL */
    .rv {
      opacity: 0;
      transform: translateY(36px);
      transition: opacity .75s cubic-bezier(.16, 1, .3, 1), transform .75s cubic-bezier(.16, 1, .3, 1);
    }

    .rv.on {
      opacity: 1;
      transform: none;
    }

    .d1 {
      transition-delay: .1s;
    }

    .d2 {
      transition-delay: .2s;
    }

    .d3 {
      transition-delay: .3s;
    }

    .d4 {
      transition-delay: .4s;
    }

    /* BG SCROLL TEXT */
    .bgt {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-d);
      font-size: clamp(55px, 9vw, 130px);
      font-weight: 800;
      color: rgba(255, 255, 255, .025);
      white-space: nowrap;
      pointer-events: none;
      user-select: none;
      z-index: 0;
      text-align: center;
      line-height: 1.2;
    }

    /* PROBLEM CARDS */
    .prob-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 56px;
      position: relative;
      z-index: 2;
    }

    .prob-card {
      background: rgba(255, 255, 255, .04);
      border: 1px solid rgba(255, 255, 255, .07);
      border-radius: 16px;
      padding: 34px 26px;
      transition: all .4s cubic-bezier(.16, 1, .3, 1);
      cursor: default;
    }

    .prob-card:hover {
      background: rgba(37, 99, 255, .12);
      border-color: rgba(37, 99, 255, .4);
      transform: translateY(-8px);
      box-shadow: 0 20px 50px rgba(37, 99, 255, .15);
    }

    .prob-ico {
      font-size: 28px;
      margin-bottom: 18px;
    }

    .prob-t {
      font-family: var(--font-d);
      font-size: 17px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 10px;
      line-height: 1.25;
    }

    .prob-txt {
      font-size: 15px;
      line-height: 1.6;
      color: rgba(255, 255, 255, .6);
    }

    /* SERVICES */
    .svc-hdr {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 60px;
    }

    .svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .svc-card {
      background: linear-gradient(135deg, #0d1a4a, #091436);
      border: 1px solid rgba(37, 99, 255, .2);
      border-radius: 20px;
      padding: 40px;
      position: relative;
      overflow: hidden;
      min-height: 260px;
      display: flex;
      flex-direction: column;
      transition: all .4s cubic-bezier(.16, 1, .3, 1);
    }

    .svc-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(37, 99, 255, .14), transparent);
      opacity: 0;
      transition: opacity .4s;
      border-radius: 20px;
    }

    .svc-card:hover {
      border-color: rgba(37, 99, 255, .6);
      transform: translateY(-6px);
      box-shadow: 0 24px 60px rgba(37, 99, 255, .2);
    }

    .svc-card:hover::before {
      opacity: 1;
    }

    .svc-3d {
      position: absolute;
      right: 30px;
      top: 30px;
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* CSS 3D objects */
    .obj-db {
      width: 74px;
      height: 74px;
      position: relative;
      -webkit-animation: objF 5s ease-in-out infinite;
      animation: objF 5s ease-in-out infinite;
    }

    .obj-db .disc {
      width: 74px;
      height: 18px;
      background: linear-gradient(135deg, #5b8fff, #1a4fd6);
      border-radius: 50%;
      position: absolute;
      box-shadow: 0 4px 16px rgba(37, 99, 255, .5);
    }

    .obj-db .disc:nth-child(1) {
      top: 0;
    }

    .obj-db .disc:nth-child(2) {
      top: 18px;
      opacity: .8;
    }

    .obj-db .disc:nth-child(3) {
      top: 36px;
      opacity: .6;
    }

    .obj-mob {
      width: 54px;
      height: 84px;
      background: linear-gradient(135deg, #5b8fff, #1a4fd6);
      border-radius: 10px;
      box-shadow: 0 8px 26px rgba(37, 99, 255, .4), inset 0 1px 0 rgba(255, 255, 255, .2);
      -webkit-animation: objF 6s ease-in-out infinite 1s;
      animation: objF 6s ease-in-out infinite 1s;
      position: relative;
    }

    .obj-mob::before {
      content: '';
      position: absolute;
      top: 10px;
      left: 7px;
      right: 7px;
      bottom: 10px;
      background: rgba(0, 0, 28, .6);
      border-radius: 6px;
    }

    .obj-bars {
      width: 76px;
      height: 76px;
      position: relative;
      -webkit-animation: objF 7s ease-in-out infinite .5s;
      animation: objF 7s ease-in-out infinite .5s;
      display: flex;
      align-items: flex-end;
      gap: 4px;
    }

    .obj-bars .b {
      background: linear-gradient(to top, #1a4fd6, #5b8fff);
      border-radius: 3px 3px 0 0;
      width: 16px;
      box-shadow: 0 4px 16px rgba(37, 99, 255, .4);
    }

    .obj-bars .b:nth-child(1) {
      height: 46px;
    }

    .obj-bars .b:nth-child(2) {
      height: 66px;
    }

    .obj-bars .b:nth-child(3) {
      height: 38px;
    }

    .obj-bars .b:nth-child(4) {
      height: 56px;
    }

    .obj-api {
      width: 76px;
      height: 76px;
      background: linear-gradient(135deg, #5b8fff, #1a4fd6);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: monospace;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      box-shadow: 0 8px 26px rgba(37, 99, 255, .4);
      -webkit-animation: objF 5.5s ease-in-out infinite 1.5s;
      animation: objF 5.5s ease-in-out infinite 1.5s;
    }

    @-webkit-keyframes objF {

      0%,
      100% {
        transform: translateY(0) rotate(0);
      }

      50% {
        transform: translateY(-10px) rotate(3deg);
      }
    }
    @keyframes objF {

      0%,
      100% {
        transform: translateY(0) rotate(0);
      }

      50% {
        transform: translateY(-10px) rotate(3deg);
      }
    }

    .svc-num {
      font-family: var(--font-d);
      font-size: 13px;
      font-weight: 600;
      color: rgba(37, 99, 255, .5);
      letter-spacing: .08em;
      margin-bottom: 18px;
    }

    .svc-title {
      font-family: var(--font-d);
      font-size: 25px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
      line-height: 1.2;
    }

    .svc-desc {
      font-size: 15px;
      line-height: 1.7;
      color: rgba(255, 255, 255, .5);
      max-width: 62%;
      flex-grow: 1;
    }

    .svc-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 26px;
      font-size: 14px;
      font-weight: 600;
      color: var(--blue-light);
      transition: all .3s;
    }

    .svc-link:hover {
      gap: 13px;
      color: #fff;
    }

    /* STATS */
    .stats-hdr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: start;
      margin-bottom: 72px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: rgba(0, 0, 0, .08);
      border-radius: 20px;
      overflow: hidden;
    }

    .stat-cell {
      background: #fff;
      padding: 44px 32px;
      text-align: center;
      transition: background .25s;
    }

    .stat-cell:hover {
      background: #f9fbff;
    }

    .stat-n {
      font-family: var(--font-d);
      font-size: 52px;
      font-weight: 800;
      color: #0a0a0a;
      line-height: 1;
      margin-bottom: 8px;
      letter-spacing: -.02em;
    }

    .stat-n span {
      color: var(--blue);
    }

    .stat-lbl {
      font-size: 14px;
      color: #888;
      font-weight: 500;
    }

    .stat-sub {
      font-size: 13px;
      color: #bbb;
      margin-top: 5px;
      line-height: 1.4;
    }

    /* WHY CHOOSE */
    .why-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
      margin-top: 56px;
    }

    .why-card {
      background: #f8f9ff;
      border: 1px solid rgba(37, 99, 255, .08);
      border-radius: 20px;
      padding: 40px;
      transition: all .35s cubic-bezier(.16, 1, .3, 1);
    }

    .why-card:hover {
      background: #fff;
      border-color: rgba(37, 99, 255, .25);
      transform: translateY(-6px);
      box-shadow: 0 18px 50px rgba(37, 99, 255, .1);
    }

    .why-ico {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, rgba(37, 99, 255, .12), rgba(37, 99, 255, .06));
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      margin-bottom: 22px;
      transition: all .3s;
    }

    .why-card:hover .why-ico {
      background: var(--blue);
      transform: rotate(-5deg) scale(1.1);
    }

    .why-t {
      font-family: var(--font-d);
      font-size: 21px;
      font-weight: 700;
      color: #0a0a0a;
      margin-bottom: 11px;
    }

    .why-d {
      font-size: 15px;
      line-height: 1.7;
      color: #666;
    }

    /* CASE STUDIES */
    .cs-tabs {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f1f3f9;
      border-radius: 100px;
      padding: 6px;
      margin: 0 auto 48px;
      width: fit-content;
    }

    .cs-tab {
      padding: 9px 22px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      color: #888;
      border: none;
      background: transparent;
      cursor: pointer;
      transition: all .3s;
      font-family: var(--font-b);
    }

    .cs-tab.active {
      background: #fff;
      color: #0a0a0a;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    }

    .cs-tab:hover:not(.active) {
      color: #0a0a0a;
    }

    .cs-panel {
      display: none;
    }

    .cs-panel.active {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    }

    .cs-meta {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .cs-badge {
      display: inline-flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }

    .cs-tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 100px;
    }

    .cs-result {
      font-size: 11px;
      font-weight: 700;
      color: #059669;
      background: #ecfdf5;
      border: 1px solid #bbf7d0;
      padding: 5px 14px;
      border-radius: 100px;
    }

    .cs-client {
      font-size: 11px;
      color: #999;
      padding: 5px 0;
    }

    .cs-title {
      font-family: var(--font-d);
      font-size: clamp(24px, 2.8vw, 38px);
      font-weight: 700;
      color: #0a0a0a;
      line-height: 1.2;
      letter-spacing: -.02em;
    }

    .cs-stats {
      display: flex;
      gap: 32px;
      padding: 24px 0;
      border-top: 1px solid rgba(0, 0, 0, .07);
      border-bottom: 1px solid rgba(0, 0, 0, .07);
    }

    .cs-stat-v {
      font-family: var(--font-d);
      font-size: 22px;
      font-weight: 800;
      color: #0a0a0a;
      line-height: 1;
    }

    .cs-stat-l {
      font-size: 11px;
      color: #999;
      margin-top: 4px;
    }

    .cs-desc {
      font-size: 15px;
      line-height: 1.75;
      color: #555;
    }

    .cs-metrics {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 4px;
    }

    .cs-m {
      background: #f8f9ff;
      border: 1px solid rgba(37, 99, 255, .1);
      border-radius: 12px;
      padding: 14px 18px;
    }

    .cs-mv {
      font-family: var(--font-d);
      font-size: 20px;
      font-weight: 800;
      color: #0a0a0a;
    }

    .cs-ml {
      font-size: 11px;
      color: #999;
      margin-top: 2px;
    }

    .cs-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--blue);
      color: #fff;
      padding: 14px 26px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: all .3s;
      margin-top: 8px;
    }

    .cs-cta:hover {
      background: var(--blue-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 26px rgba(37, 99, 255, .35);
    }

    .cs-dashboard {
      background: #0f1117;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .07);
      box-shadow: 0 32px 80px rgba(0, 0, 0, .25);
    }

    .cs-db-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, .05);
      background: #0a0d14;
    }

    .cs-db-dots {
      display: flex;
      gap: 6px;
    }

    .cs-db-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
    }

    .cs-db-url {
      flex: 1;
      margin: 0 12px;
      height: 24px;
      background: rgba(255, 255, 255, .05);
      border-radius: 6px;
      display: flex;
      align-items: center;
      padding: 0 12px;
    }

    .cs-db-url span {
      font-size: 9px;
      color: rgba(255, 255, 255, .25);
      font-family: monospace;
      letter-spacing: .04em;
    }

    .cs-db-live {
      padding: 4px 10px;
      border-radius: 5px;
      font-size: 9px;
      font-weight: 700;
      color: #fff;
      letter-spacing: .06em;
    }

    .cs-db-body {
      display: grid;
      grid-template-columns: 1fr 2fr;
      height: 320px;
      overflow: hidden;
    }

    .cs-db-left {
      border-right: 1px solid rgba(255, 255, 255, .05);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .cs-db-lbl {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .3);
    }

    .cs-db-metric {
      display: flex;
      flex-direction: column;
    }

    .cs-db-mv {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -.02em;
      line-height: 1;
    }

    .cs-db-ml {
      font-size: 9px;
      color: rgba(255, 255, 255, .35);
      margin-top: 2px;
    }

    .cs-db-bars {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cs-db-bar-row {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .cs-db-bar-labels {
      display: flex;
      justify-content: space-between;
      font-size: 8px;
      color: rgba(255, 255, 255, .25);
    }

    .cs-db-bar-track {
      height: 3px;
      background: rgba(255, 255, 255, .06);
      border-radius: 2px;
    }

    .cs-db-bar-fill {
      height: 100%;
      border-radius: 2px;
    }

    .cs-db-right {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      overflow: hidden;
    }

    .cs-db-row {
      background: rgba(255, 255, 255, .03);
      border: 1px solid rgba(255, 255, 255, .05);
      border-radius: 8px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      opacity: 0;
      transform: translateX(10px);
      transition: opacity .4s, transform .4s;
    }

    .cs-db-row.show {
      opacity: 1;
      transform: none;
    }

    .cs-db-rid {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cs-db-dot2 {
      width: 5px;
      height: 5px;
      border-radius: 50%;
    }

    .cs-db-id {
      font-size: 9px;
      color: rgba(255, 255, 255, .4);
      font-family: monospace;
    }

    .cs-db-bars2 {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .cs-db-seg {
      height: 5px;
      border-radius: 3px;
      background: rgba(255, 255, 255, .1);
    }

    .cs-db-seg.accent {
      opacity: .4;
    }

    .cs-db-time {
      font-size: 8px;
      color: rgba(255, 255, 255, .18);
      font-family: monospace;
    }

    .cs-db-chart {
      display: flex;
      align-items: flex-end;
      gap: 4px;
      height: 40px;
      padding: 0 18px 12px;
      margin-top: auto;
    }

    .cs-db-chart-bar {
      flex: 1;
      border-radius: 2px 2px 0 0;
    }

    /* INDUSTRIES HEXAGONS */
    /* ─── Industries Showcase ─── */
    .ind-showcase {
      display: flex;
      gap: 52px;
      align-items: flex-start;
      max-width: 1240px;
      margin: 56px auto 0;
      position: relative;
      z-index: 2;
    }

    .ind-cols {
      display: flex;
      gap: 10px;
      flex-shrink: 0;
    }

    .ind-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ind-col-2 {
      margin-top: 72px;
    }

    .ind-col-3 {
      margin-top: 36px;
    }

    .ind-photo {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      transition: opacity .4s cubic-bezier(.16, 1, .3, 1);
    }

    .ind-col-1 .ind-photo:nth-child(1) {
      width: 158px;
      height: 176px;
    }

    .ind-col-1 .ind-photo:nth-child(2) {
      width: 158px;
      height: 156px;
    }

    .ind-col-1 .ind-photo:nth-child(3) {
      width: 158px;
      height: 166px;
    }

    .ind-col-2 .ind-photo {
      width: 176px;
      height: 190px;
    }

    .ind-col-3 .ind-photo {
      width: 165px;
      height: 182px;
    }

    .ind-col-3 .ind-photo:only-child {
      height: 374px;
    }

    .ind-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) brightness(.65);
      transition: filter .5s cubic-bezier(.16, 1, .3, 1), transform .5s cubic-bezier(.16, 1, .3, 1);
    }

    .ind-photo.hov-active img {
      filter: grayscale(0) brightness(1);
      transform: scale(1.05);
    }

    .ind-photo.hov-dimmed {
      opacity: .4;
    }

    .ind-photo-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, .78) 0%, rgba(0, 0, 0, .08) 55%, transparent 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding: 0 10px 16px;
      text-align: center;
    }

    .ind-photo-sub {
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .45);
      margin-bottom: 5px;
    }

    .ind-photo-name {
      font-family: var(--font-d);
      font-size: 13px;
      font-weight: 800;
      color: #fff;
      line-height: 1.25;
      letter-spacing: -.01em;
    }

    /* Right list */
    .ind-list {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-top: 2px;
    }

    .ind-row {
      display: block;
      cursor: pointer;
      transition: opacity .3s;
      padding: 15px 0;
      border-bottom: 1px solid rgba(255, 255, 255, .06);
      text-decoration: none;
    }

    .ind-row:first-child {
      border-top: 1px solid rgba(255, 255, 255, .06);
    }

    .ind-row.hov-dimmed {
      opacity: .3;
    }

    .ind-row-inner {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .ind-row-bar {
      width: 18px;
      height: 10px;
      border-radius: 5px;
      background: rgba(255, 255, 255, .18);
      transition: all .3s;
      flex-shrink: 0;
    }

    .ind-row.hov-active .ind-row-bar {
      background: #fff;
      width: 26px;
    }

    .ind-row-name {
      font-family: var(--font-d);
      font-size: clamp(17px, 1.8vw, 24px);
      font-weight: 800;
      color: rgba(255, 255, 255, .6);
      letter-spacing: -.025em;
      line-height: 1;
      transition: color .3s;
    }

    .ind-row.hov-active .ind-row-name {
      color: #fff;
    }

    .ind-row-tag {
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .17em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .25);
      padding-left: 32px;
      margin-top: 5px;
      transition: color .3s;
    }

    .ind-row.hov-active .ind-row-tag {
      color: rgba(96, 165, 250, .85);
    }

    /* PROCESS */
    .proc-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      margin-top: 60px;
      position: relative;
    }

    .proc-grid::before {
      content: '';
      position: absolute;
      top: 39px;
      left: calc(12.5% + 18px);
      right: calc(12.5% + 18px);
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(37, 99, 255, .4), rgba(37, 99, 255, .4), transparent);
    }

    .proc-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 18px;
      position: relative;
      z-index: 1;
    }

    .proc-num {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-d);
      font-size: 24px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 26px;
      box-shadow: 0 8px 28px rgba(37, 99, 255, .4);
      transition: transform .3s;
    }

    .proc-step:hover .proc-num {
      transform: scale(1.1);
    }

    .proc-t {
      font-family: var(--font-d);
      font-size: 18px;
      font-weight: 700;
      color: #0a0a0a;
      margin-bottom: 11px;
    }

    .proc-d {
      font-size: 14px;
      line-height: 1.7;
      color: #777;
    }

    /* TESTIMONIALS */
    .test-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 56px;
    }

    .test-card {
      background: #fff;
      border: 1px solid rgba(0, 0, 0, .08);
      border-radius: 20px;
      padding: 36px;
      transition: all .35s cubic-bezier(.16, 1, .3, 1);
    }

    .test-card:hover {
      border-color: rgba(37, 99, 255, .2);
      transform: translateY(-5px);
      box-shadow: 0 18px 50px rgba(0, 0, 0, .08);
    }

    .stars {
      display: flex;
      gap: 3px;
      margin-bottom: 18px;
    }

    .star {
      color: #f59e0b;
      font-size: 15px;
    }

    .test-txt {
      font-size: 15px;
      line-height: 1.7;
      color: #444;
      margin-bottom: 26px;
    }

    .test-auth {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .auth-av {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-d);
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      flex-shrink: 0;
    }

    .auth-name {
      font-family: var(--font-d);
      font-size: 15px;
      font-weight: 700;
      color: #0a0a0a;
    }

    .auth-role {
      font-size: 13px;
      color: var(--muted);
    }

    /* CTA SECTION */
    .cta-sec {
      background: linear-gradient(135deg, #0d1b4b, #091436, #050e2b);
      padding: 100px 80px;
      position: relative;
      overflow: hidden;
    }

    .cta-sec::before {
      content: '';
      position: absolute;
      top: -80px;
      right: -80px;
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, rgba(37, 99, 255, .22), transparent 70%);
      pointer-events: none;
    }

    .cta-sec::after {
      content: '';
      position: absolute;
      bottom: -60px;
      left: -60px;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(37, 99, 255, .16), transparent 70%);
      pointer-events: none;
    }

    .cta-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: center;
      position: relative;
      z-index: 2;
    }

    .cta-h {
      font-family: var(--font-d);
      font-size: clamp(34px, 4vw, 56px);
      font-weight: 600;
      color: #fff;
      line-height: 1.1;
      letter-spacing: -.025em;
      margin-bottom: 18px;
    }

    .cta-h .it {
      font-style: italic;
      font-weight: 800;
      color: var(--blue-light);
    }

    .cta-sub {
      font-size: 16px;
      color: rgba(255, 255, 255, .5);
      line-height: 1.7;
      margin-bottom: 34px;
    }

    .cta-nums {
      display: flex;
      gap: 38px;
    }

    .cta-n {
      font-family: var(--font-d);
      font-size: 34px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -.02em;
    }

    .cta-nl {
      font-size: 13px;
      color: rgba(255, 255, 255, .45);
      margin-top: 2px;
    }

    .cta-form {
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 22px;
      padding: 38px;
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }

    .cta-form h3 {
      font-family: var(--font-d);
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 6px;
    }

    .cta-form p {
      font-size: 14px;
      color: rgba(255, 255, 255, .45);
      margin-bottom: 26px;
    }

    .fg {
      margin-bottom: 14px;
    }

    .fi {
      width: 100%;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 10px;
      padding: 13px 16px;
      font-size: 14px;
      color: #fff;
      font-family: var(--font-b);
      outline: none;
      transition: border-color .25s, background .25s;
    }

    .fi::placeholder {
      color: rgba(255, 255, 255, .28);
    }

    .fi:focus {
      border-color: rgba(37, 99, 255, .6);
      background: rgba(37, 99, 255, .07);
    }

    textarea.fi {
      resize: none;
      height: 96px;
    }

    .fsub {
      width: 100%;
      background: var(--blue);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 15px;
      font-size: 15px;
      font-weight: 600;
      font-family: var(--font-b);
      cursor: pointer;
      transition: all .3s;
      margin-top: 6px;
    }

    .fsub:hover {
      background: var(--blue-dark);
      box-shadow: 0 8px 28px rgba(37, 99, 255, .5);
      transform: translateY(-2px);
    }

    /* FAQ */
    .faq-lay {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 72px;
      align-items: start;
    }

    .faq-side {
      position: sticky;
      top: 90px;
    }

    .faq-side-sub {
      font-size: 15px;
      color: #666;
      line-height: 1.7;
      margin-bottom: 32px;
    }

    .faq-ccard {
      background: linear-gradient(135deg, #0d1b4b, #091436);
      border-radius: 18px;
      padding: 30px;
      color: #fff;
    }

    .faq-ccard h4 {
      font-family: var(--font-d);
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .faq-ccard p {
      font-size: 14px;
      color: rgba(255, 255, 255, .5);
      margin-bottom: 18px;
    }

    .faq-clink {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--blue);
      color: #fff;
      padding: 11px 22px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      transition: all .3s;
    }

    .faq-clink:hover {
      background: var(--blue-dark);
      gap: 13px;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .faq-item {
      border: 1px solid rgba(0, 0, 0, .08);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color .25s;
    }

    .faq-item.open {
      border-color: rgba(37, 99, 255, .25);
    }

    .faq-q {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 26px;
      cursor: pointer;
      transition: background .2s;
      user-select: none;
    }

    .faq-q:hover {
      background: rgba(37, 99, 255, .03);
    }

    .faq-qt {
      font-family: var(--font-d);
      font-size: 16px;
      font-weight: 600;
      color: #0a0a0a;
      flex: 1;
      padding-right: 18px;
      line-height: 1.4;
    }

    .faq-ic {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(37, 99, 255, .08);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all .3s;
      font-size: 18px;
      color: var(--blue);
    }

    .faq-item.open .faq-ic {
      background: var(--blue);
      color: #fff;
      transform: rotate(45deg);
    }

    .faq-ans {
      max-height: 0;
      overflow: hidden;
      transition: max-height .4s cubic-bezier(.16, 1, .3, 1), padding .3s;
      padding: 0 26px;
    }

    .faq-item.open .faq-ans {
      max-height: 280px;
      padding: 0 26px 22px;
    }

    .faq-ans p {
      font-size: 15px;
      line-height: 1.7;
      color: #666;
    }

    /* FOOTER */
    .footer{background:#050508;color:#fff;padding:72px 80px 36px;}
    .ft{display:grid;grid-template-columns:2.5fr 1fr 1.5fr 1fr 1fr;gap:44px;padding-bottom:56px;border-bottom:1px solid rgba(255,255,255,.06);}
    .fb-desc{font-size:14px;line-height:1.7;color:rgba(255,255,255,.65);max-width:250px;margin:18px 0 26px;}
    .socials{display:flex;gap:10px;}
    .soc{width:36px;height:36px;border:1px solid rgba(255,255,255,.1);border-radius:7px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.45);transition:all .3s;}
    .soc:hover{border-color:var(--blue);background:rgba(37,99,255,.15);color:#fff;transform:translateY(-2px);}
    .fc h4{font-family:var(--font-d);font-size:12px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.1em;margin-bottom:18px;}
    .fl{display:flex;flex-direction:column;gap:11px;}
    .fl a{font-size:14px;color:rgba(255,255,255,.85);transition:color .25s;}
    .fl a:hover{color:#fff;}
    .fbot{display:flex;align-items:center;justify-content:space-between;padding-top:30px;flex-wrap:wrap;gap:12px;}
    .fcopy{font-size:13px;color:rgba(255,255,255,.5);}
    .fleg{display:flex;gap:22px;flex-wrap:wrap;}
    .fleg a{font-size:13px;color:rgba(255,255,255,.5);transition:color .25s;}
    .fleg a:hover{color:rgba(255,255,255,.75);}
    .fdisclaim{font-size:11px;color:rgba(255,255,255,.35);text-align:center;margin-top:22px;line-height:1.6;max-width:700px;margin-left:auto;margin-right:auto;}

    /* SCROLL TOP */
    .stb {
      position: fixed;
      bottom: 32px;
      right: 32px;
      width: 46px;
      height: 46px;
      background: var(--blue);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      z-index: 500;
      opacity: 0;
      transform: translateY(16px);
      transition: all .3s;
      box-shadow: 0 6px 20px rgba(37, 99, 255, .4);
    }

    .stb.on {
      opacity: 1;
      transform: none;
    }

    .stb:hover {
      background: var(--blue-dark);
      transform: translateY(-3px);
    }

    /* ===== GRADIENT BORDER ICON SYSTEM ===== */
    .ico-g {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, rgba(37, 99, 255, .13), rgba(37, 99, 255, .04));
      border: 1.5px solid rgba(37, 99, 255, .22);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all .3s;
    }

    .ico-g svg {
      width: 22px;
      height: 22px;
      stroke: var(--blue);
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .ico-g.wh {
      border-radius: 8px;
      background: linear-gradient(180deg, rgba(37, 94, 255, 0.80) 0%, rgba(1, 35, 131, 0.80) 100%);
      box-shadow: 0 2px 7.8px 1px rgba(0, 0, 0, 0.25);
    }

    .ico-g.wh svg {
      stroke: rgba(255, 255, 255, .8);
    }

    .ico-g.em {
      background: linear-gradient(135deg, rgba(16, 185, 129, .13), rgba(16, 185, 129, .04));
      border-color: rgba(16, 185, 129, .22);
    }

    .ico-g.em svg {
      stroke: #10b981;
    }

    .ico-g.vl {
      background: linear-gradient(135deg, rgba(124, 58, 237, .13), rgba(124, 58, 237, .04));
      border-color: rgba(124, 58, 237, .22);
    }

    .ico-g.vl svg {
      stroke: #7c3aed;
    }

    .ico-g.lg {
      width: 60px;
      height: 60px;
      border-radius: 18px;
    }

    .ico-g.lg svg {
      width: 26px;
      height: 26px;
    }

    /* ===== SERVICE CARD CAROUSEL ===== */
    .svc-car-wrap {
      overflow: hidden;
      border-radius: 24px;
    }

    .svc-car-track {
      display: flex;
      transition: transform .6s cubic-bezier(.16, 1, .3, 1);
      will-change: transform;
    }

    .svc-car-slide {
      min-width: 100%;
    }

    .svc-card {
      min-height: 460px;
      padding: 64px 72px;
      display: grid;
      grid-template-columns: 1fr 310px;
      gap: 48px;
      align-items: center;
      position: relative;
      overflow: hidden;
      border-radius: 24px;
    }

    .svc-card::before {
      content: '';
      position: absolute;
      top: -100px;
      right: -100px;
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(255, 255, 255, .1) 0%, transparent 65%);
      border-radius: 50%;
      pointer-events: none;
    }

    .svc-card::after {
      content: '';
      position: absolute;
      bottom: -80px;
      left: -80px;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(0, 0, 0, .22) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .svc-card-content {
      position: relative;
      z-index: 2;
    }

    .svc-card-sub {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .4);
      margin-bottom: 12px;
    }

    .svc-card-h {
      font-family: var(--font-d);
      font-size: clamp(28px, 3.8vw, 52px);
      font-weight: 300;
      color: #fff;
      line-height: 1.1;
      letter-spacing: -.025em;
      margin-bottom: 16px;
    }

    .svc-card-h em {
      font-weight: 800;
      font-style: italic;
      display: block;
    }

    .svc-card-desc {
      font-size: 15px;
      color: rgba(255, 255, 255, .52);
      line-height: 1.78;
      max-width: 520px;
      margin-bottom: 30px;
    }

    .svc-card-tags {
      display: flex;
      flex-wrap: wrap;
      margin-bottom: 36px;
      line-height: 1.8;
    }

    .svc-card-tag {
      font-size: 12.5px;
      color: rgba(255, 255, 255, .48);
    }

    .svc-card-tag::after {
      content: ' /';
      color: rgba(255, 255, 255, .2);
      margin: 0 7px;
    }

    .svc-card-tag:last-child::after {
      display: none;
    }

    .svc-card-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, .1);
      border: 1.5px solid rgba(255, 255, 255, .2);
      color: #fff;
      padding: 13px 26px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 700;
      font-family: var(--font-b);
      letter-spacing: .06em;
      transition: all .3s;
      text-decoration: none;
    }

    .svc-card-cta:hover {
      background: rgba(255, 255, 255, .2);
      border-color: rgba(255, 255, 255, .5);
      transform: translateY(-2px);
    }

    .svc-card-cta svg {
      width: 13px;
      height: 13px;
      stroke: #fff;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }

    .svc-card-art {
      position: relative;
      height: 310px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      z-index: 2;
    }

    /* Nav */
    .svc-car-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 22px;
    }

    .svc-car-dots {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .svc-car-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .2);
      border: none;
      cursor: pointer;
      transition: all .3s;
      padding: 0;
    }

    .svc-car-dot.active {
      width: 28px;
      border-radius: 4px;
      background: rgba(255, 255, 255, .65);
    }

    .svc-car-arws {
      display: flex;
      gap: 10px;
    }

    .svc-arr {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid rgba(255, 255, 255, .15);
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      cursor: pointer;
      transition: all .3s;
    }

    .svc-arr:hover {
      background: rgba(255, 255, 255, .12);
      border-color: rgba(255, 255, 255, .4);
    }

    .svc-arr svg {
      width: 16px;
      height: 16px;
      stroke: rgba(255, 255, 255, .65);
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .svc-car-count {
      font-family: var(--font-d);
      font-size: 12px;
      font-weight: 700;
      color: rgba(255, 255, 255, .28);
      letter-spacing: .12em;
    }

    /* ART 1   Orbital sphere (Enterprise Scraping) */
    .art-orb {
      position: relative;
      width: 270px;
      height: 270px;
    }

    .art-orb-glow {
      position: absolute;
      inset: -30px;
      background: radial-gradient(circle, rgba(255, 255, 255, .15) 0%, transparent 65%);
      border-radius: 50%;
    }

    .art-orb-stage {
      width: 100%;
      height: 100%;
      perspective: 550px;
    }

    .art-orb-inner {
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      -webkit-animation: artOrbY 18s linear infinite;
      animation: artOrbY 18s linear infinite;
      position: relative;
    }

    .art-ring {
      position: absolute;
      border-radius: 50%;
      top: 50%;
      left: 50%;
    }

    .art-ring:nth-child(1) {
      width: 250px;
      height: 250px;
      margin: -125px 0 0 -125px;
      border: 3px solid rgba(255, 255, 255, .38);
      border-top-color: transparent;
      transform: rotateX(76deg);
    }

    .art-ring:nth-child(2) {
      width: 208px;
      height: 208px;
      margin: -104px 0 0 -104px;
      border: 2.5px solid rgba(255, 255, 255, .26);
      border-right-color: transparent;
      transform: rotateX(76deg) rotateY(72deg);
    }

    .art-ring:nth-child(3) {
      width: 162px;
      height: 162px;
      margin: -81px 0 0 -81px;
      border: 2px solid rgba(255, 255, 255, .18);
      border-bottom-color: transparent;
      transform: rotateX(66deg) rotateY(144deg);
    }

    .art-core {
      position: absolute;
      width: 90px;
      height: 90px;
      top: 50%;
      left: 50%;
      margin: -45px 0 0 -45px;
      border-radius: 50%;
      background: radial-gradient(circle at 36% 34%, rgba(255, 255, 255, .75), rgba(255, 255, 255, .18));
      box-shadow: 0 0 50px rgba(255, 255, 255, .25);
    }

    @-webkit-keyframes artOrbY {
      to {
        transform: rotateY(360deg);
      }
    }
    @keyframes artOrbY {
      to {
        transform: rotateY(360deg);
      }
    }

    /* ART 2   Petal flower (Mobile App   matches reference) */
    .art-flower {
      position: relative;
      width: 270px;
      height: 270px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .art-flower-spin {
      width: 220px;
      height: 220px;
      position: relative;
      -webkit-animation: flowerR 14s linear infinite;
      animation: flowerR 14s linear infinite;
    }

    .art-petal {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 60px;
      height: 170px;
      border-radius: 50%;
      margin: -170px 0 0 -30px;
      transform-origin: center 170px;
    }

    .art-petal:nth-child(1) {
      transform: rotate(0deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .7), rgba(255, 255, 255, .08));
    }

    .art-petal:nth-child(2) {
      transform: rotate(45deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .55), rgba(255, 255, 255, .06));
    }

    .art-petal:nth-child(3) {
      transform: rotate(90deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .65), rgba(255, 255, 255, .07));
    }

    .art-petal:nth-child(4) {
      transform: rotate(135deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .5), rgba(255, 255, 255, .05));
    }

    .art-petal:nth-child(5) {
      transform: rotate(180deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .6), rgba(255, 255, 255, .07));
    }

    .art-petal:nth-child(6) {
      transform: rotate(225deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .45), rgba(255, 255, 255, .05));
    }

    .art-petal:nth-child(7) {
      transform: rotate(270deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .7), rgba(255, 255, 255, .08));
    }

    .art-petal:nth-child(8) {
      transform: rotate(315deg);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .5), rgba(255, 255, 255, .06));
    }

    .art-flower-core {
      position: absolute;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: radial-gradient(circle at 38% 36%, rgba(255, 255, 255, .9), rgba(255, 255, 255, .3));
      box-shadow: 0 0 40px rgba(255, 255, 255, .3);
    }

    @-webkit-keyframes flowerR {
      to {
        transform: rotate(360deg);
      }
    }
    @keyframes flowerR {
      to {
        transform: rotate(360deg);
      }
    }

    /* ART 3   Crystal diamond (Analytics) */
    .art-crystal {
      position: relative;
      width: 270px;
      height: 270px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .art-crystal-wrap {
      width: 150px;
      height: 170px;
      position: relative;
      -webkit-animation: crystalFloat 5.5s ease-in-out infinite;
      animation: crystalFloat 5.5s ease-in-out infinite;
    }

    .art-c-top {
      position: absolute;
      width: 100%;
      height: 55%;
      top: 0;
      left: 0;
      -webkit-clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
      clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
      background: linear-gradient(165deg, rgba(255, 255, 255, .85) 0%, rgba(255, 255, 255, .3) 100%);
    }

    .art-c-left {
      position: absolute;
      width: 50%;
      height: 50%;
      bottom: 0;
      left: 0;
      -webkit-clip-path: polygon(100% 0%, 100% 100%, 0% 60%);
      clip-path: polygon(100% 0%, 100% 100%, 0% 60%);
      background: rgba(255, 255, 255, .22);
    }

    .art-c-right {
      position: absolute;
      width: 50%;
      height: 50%;
      bottom: 0;
      right: 0;
      -webkit-clip-path: polygon(0% 0%, 100% 60%, 0% 100%);
      clip-path: polygon(0% 0%, 100% 60%, 0% 100%);
      background: rgba(255, 255, 255, .38);
    }

    .art-c-bot {
      position: absolute;
      width: 100%;
      height: 50%;
      bottom: 0;
      left: 0;
      -webkit-clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
      clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
      background: linear-gradient(to bottom, rgba(255, 255, 255, .3), rgba(255, 255, 255, .06));
    }

    .art-crystal-glow {
      position: absolute;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, .15) 0%, transparent 70%);
      pointer-events: none;
    }

    @-webkit-keyframes crystalFloat {

      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }

      50% {
        transform: translateY(-16px) rotate(4deg);
      }
    }
    @keyframes crystalFloat {

      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }

      50% {
        transform: translateY(-16px) rotate(4deg);
      }
    }

    /* ART 4   Node network (API) */
    .art-nodes {
      position: relative;
      width: 270px;
      height: 270px;
    }

    .art-node {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, .85);
      box-shadow: 0 0 18px rgba(255, 255, 255, .35);
    }

    .art-node-hub {
      width: 46px;
      height: 46px;
      top: 50%;
      left: 50%;
      margin: -23px 0 0 -23px;
      background: radial-gradient(circle at 38% 36%, rgba(255, 255, 255, .95), rgba(255, 255, 255, .45));
      box-shadow: 0 0 44px rgba(255, 255, 255, .4);
      -webkit-animation: hubPulse 2.5s ease-in-out infinite;
      animation: hubPulse 2.5s ease-in-out infinite;
    }

    .art-node-sm {
      width: 20px;
      height: 20px;
      -webkit-animation: hubPulse 2.5s ease-in-out infinite;
      animation: hubPulse 2.5s ease-in-out infinite;
    }

    @-webkit-keyframes hubPulse {

      0%,
      100% {
        transform: scale(1);
        opacity: .75;
      }

      50% {
        transform: scale(1.25);
        opacity: 1;
      }
    }
    @keyframes hubPulse {

      0%,
      100% {
        transform: scale(1);
        opacity: .75;
      }

      50% {
        transform: scale(1.25);
        opacity: 1;
      }
    }

    @media(max-width:1100px) {
      .svc-card {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .svc-card-art {
        display: none;
      }
    }

    /* ===== FORMULA SECTION ===== */
    .formula-lay {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 72px;
      align-items: start;
    }

    .formula-title {
      font-family: var(--font-d);
      font-size: clamp(36px, 4.2vw, 58px);
      font-weight: 300;
      color: #0a0a0a;
      line-height: 1.1;
      letter-spacing: -.03em;
      margin-bottom: 18px;
    }

    .formula-title .it {
      font-weight: 800;
      font-style: italic;
    }

    .formula-desc {
      font-size: 15px;
      line-height: 1.8;
      color: #555;
      margin-bottom: 36px;
      max-width: 360px;
    }

    .formula-stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border: 1px solid rgba(0, 0, 0, .07);
      border-radius: 22px;
      overflow: hidden;
    }

    .f-stat {
      padding: 30px 26px;
      border-right: 1px solid rgba(0, 0, 0, .06);
      border-bottom: 1px solid rgba(0, 0, 0, .06);
      transition: background .3s;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .f-stat:nth-child(even) {
      border-right: none;
    }

    .f-stat:nth-last-child(-n+2) {
      border-bottom: none;
    }

    .f-stat:hover {
      background: #f9fbff;
    }

    .f-stat-ico-wrap {
      margin-bottom: 2px;
    }

    .f-stat-ico {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(37, 99, 255, .08);
      border: 1.5px solid rgba(37, 99, 255, .28);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background .3s, border-color .3s;
    }

    .f-stat:hover .f-stat-ico {
      background: rgba(37, 99, 255, .14);
      border-color: rgba(37, 99, 255, .5);
    }

    .f-stat-ico svg {
      width: 19px;
      height: 19px;
      stroke: #2563FF;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .f-stat-n {
      font-family: var(--font-d);
      font-size: 38px;
      font-weight: 800;
      color: #0a0a0a;
      letter-spacing: -.025em;
      line-height: 1;
    }

    .f-stat-n sup {
      font-size: 20px;
      color: var(--blue);
      vertical-align: super;
      margin-left: 1px;
    }

    .f-stat-l {
      font-size: 14px;
      font-weight: 700;
      color: #222;
    }

    .f-stat-d {
      font-size: 12px;
      color: #aaa;
      line-height: 1.5;
    }

    .formula-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 40px;
      border-top: 1px solid rgba(0, 0, 0, .07);
      margin-top: 52px;
    }

    .formula-team {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .team-avs {
      display: flex;
    }

    .team-av {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 3px solid #fff;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-d);
      font-size: 13px;
      font-weight: 800;
      color: #fff;
      margin-left: -14px;
      flex-shrink: 0;
    }

    .team-av:first-child {
      margin-left: 0;
    }

    .team-av:nth-child(2) {
      background: linear-gradient(135deg, #10b981, #059669);
    }

    .team-av:nth-child(3) {
      background: linear-gradient(135deg, #7c3aed, #5b21b6);
    }

    .team-av:nth-child(4) {
      background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .team-info .team-txt {
      font-family: var(--font-d);
      font-size: 22px;
      font-weight: 800;
      color: #0a0a0a;
      line-height: 1;
    }

    .team-info .team-sub {
      font-size: 13px;
      color: #999;
      margin-top: 3px;
    }

    /* ===== CASE STUDIES REDESIGN ===== */
    .cs-new-tabs {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f1f3f9;
      border-radius: 100px;
      padding: 6px;
      margin: 0 auto 48px;
      width: fit-content;
    }

    .cs-new-tab {
      padding: 9px 22px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      color: #888;
      border: none;
      background: transparent;
      cursor: pointer;
      transition: all .3s;
      font-family: var(--font-b);
    }

    .cs-new-tab.active {
      background: #fff;
      color: #0a0a0a;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    }

    .cs-proj {
      display: none;
    }

    .cs-proj.active {
      display: block;
      -webkit-animation: csIn .4s cubic-bezier(.16, 1, .3, 1);
      animation: csIn .4s cubic-bezier(.16, 1, .3, 1);
    }

    @-webkit-keyframes csIn {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes csIn {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .cs-proj-hdr {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .cs-proj-title-wrap {
      flex: 1;
    }

    .cs-proj-title {
      font-family: var(--font-d);
      font-size: clamp(24px, 3vw, 40px);
      font-weight: 700;
      color: #0a0a0a;
      letter-spacing: -.025em;
      line-height: 1.15;
    }

    .cs-proj-arrow {
      width: 50px;
      height: 50px;
      border: 1.5px solid rgba(0, 0, 0, .12);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #333;
      transition: all .3s;
      flex-shrink: 0;
      text-decoration: none;
      margin-left: 20px;
    }

    .cs-proj-arrow:hover {
      background: var(--blue);
      border-color: var(--blue);
      color: #fff;
      transform: rotate(-45deg);
    }

    .cs-proj-arrow svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
    }

    .cs-proj-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 26px;
      padding-bottom: 26px;
      border-bottom: 1px solid rgba(0, 0, 0, .07);
    }

    .cs-proj-tag {
      font-size: 11px;
      font-weight: 500;
      color: #555;
      border: 1px solid rgba(0, 0, 0, .1);
      border-radius: 100px;
      padding: 5px 16px;
      transition: all .25s;
      cursor: default;
    }

    .cs-proj-tag:hover {
      border-color: var(--blue);
      color: var(--blue);
    }

    .cs-proj-body {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: 14px;
    }

    .cs-proj-main {
      background: #0d1117;
      border-radius: 18px;
      overflow: hidden;
      min-height: 340px;
      position: relative;
    }

    .cs-mock {
      width: 100%;
      height: 100%;
      min-height: 340px;
    }

    .cs-proj-panels {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .cs-proj-screen {
      background: #0d1117;
      border-radius: 14px;
      overflow: hidden;
      flex: 1;
      min-height: 155px;
    }

    .cs-proj-desc {
      background: #f8f9ff;
      border: 1px solid rgba(37, 99, 255, .08);
      border-radius: 14px;
      padding: 24px;
      flex: 1;
    }

    .cs-proj-desc-lbl {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #aaa;
      margin-bottom: 8px;
    }

    .cs-proj-desc p {
      font-size: 13px;
      line-height: 1.75;
      color: #555;
    }

    .cs-proj-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 32px;
    }

    .cs-btn-nav {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #888;
      cursor: pointer;
      border: none;
      background: none;
      transition: color .25s;
      font-family: var(--font-b);
      padding: 0;
    }

    .cs-btn-nav:hover {
      color: var(--blue);
    }

    .cs-counter {
      font-size: 13px;
      color: #bbb;
      font-family: var(--font-d);
      font-weight: 600;
      letter-spacing: .04em;
    }

    /* ===== BLOG SECTION ===== */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 56px;
    }

    .blog-card {
      background: #fff;
      border: 1px solid rgba(0, 0, 0, .07);
      border-radius: 22px;
      overflow: hidden;
      transition: all .35s cubic-bezier(.16, 1, .3, 1);
    }

    .blog-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 22px 60px rgba(0, 0, 0, .1);
      border-color: rgba(37, 99, 255, .18);
    }

    .blog-art {
      height: 210px;
      overflow: hidden;
      position: relative;
    }

    .blog-art-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .4s ease;
    }

    .blog-card:hover .blog-art-img {
      transform: scale(1.05);
    }

    .blog-body {
      padding: 26px;
    }

    .blog-cat {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #fff;
      background: #2563FF;
      padding: 6px 12px;
      border-radius: 6px;
      margin-bottom: 12px;
      display: inline-block;
      opacity: 1;
      visibility: visible;
      z-index: 5;
    }

    .blog-title {
      font-family: var(--font-d);
      font-size: 18px;
      font-weight: 700;
      color: #0a0a0a;
      line-height: 1.35;
      margin-bottom: 11px;
    }

    .blog-exc {
      font-size: 13.5px;
      color: #666;
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .blog-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 16px;
      border-top: 1px solid rgba(0, 0, 0, .06);
    }

    .blog-date {
      font-size: 11px;
      color: #bbb;
    }

    .blog-read {
      font-size: 13px;
      font-weight: 600;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: gap .25s;
    }

    .blog-read:hover {
      gap: 10px;
    }

    .blog-read svg {
      width: 13px;
      height: 13px;
      stroke: var(--blue);
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }

    /* RESPONSIVE */
    @media(max-width:1100px) {
      .sec {
        padding: 80px 44px;
      }

      .hero {
        padding: 100px 44px 100px;
        min-height: auto;
      }

      .hero-content {
        top: 60px;
      }

      .hero-globe-bg {
        width: 560px;
        height: 560px;
        bottom: -60px;
        z-index: 0;
      }

      .prob-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .svc-grid {
        grid-template-columns: 1fr;
      }

      .stats-hdr {
        grid-template-columns: 1fr;
        gap: 36px;
      }

      .hero-squiggle {
        right: 20px;
      }

      .hero-arc {
        right: -240px;
      }

      .cta-inner {
        grid-template-columns: 1fr;
      }

      .faq-lay {
        grid-template-columns: 1fr;
      }

      .ft {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 28px;
      }

      .proc-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 36px;
      }

      .proc-grid::before {
        display: none;
      }

      .cs-panel.active {
        grid-template-columns: 1fr;
      }

      .svc-card {
        padding: 48px 44px;
      }

      .formula-lay {
        grid-template-columns: 1fr;
      }

      .cs-proj-body {
        grid-template-columns: 1fr;
      }

      .blog-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media(max-width:960px) {
      .nav {
        padding: 0 22px;
      }

      .nav-toggle {
        display: flex;
      }

      .nl {
        position: fixed;
        top: 70px;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: #fff;
        padding: 10px 22px 22px;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
        box-shadow: 0 24px 44px rgba(0, 0, 0, .13);
        max-height: calc(100vh - 70px);
        overflow-y: auto;
        transform: translateY(-14px);
        opacity: 0;
        visibility: hidden;
        transition: transform .3s, opacity .3s, visibility .3s;
      }

      .nav-open .nl {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }

      .nav-open .nl a,
      .nav.dark.nav-open .nl a {
        color: #0a0a0a !important;
      }

      .nav-drop a {
        color: #555 !important;
      }

      .nl li {
        width: 100%;
      }

      .nl>li>a {
        display: block;
        padding: 14px 6px;
        font-size: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, .06);
      }

      .nl a::after {
        display: none !important;
      }

      .nl .has-drop>a span {
        float: right;
      }

      .nav-drop {
        position: static;
        transform: none;
        box-shadow: none;
        border: none;
        background: transparent;
        padding: 2px 0 10px 14px;
        min-width: 0;
      }

      .nav-drop a {
        font-size: 14px;
        padding: 9px 8px;
        color: #555;
      }

      .nl .nav-cta {
        display: block;
        text-align: center;
        margin-top: 16px;
      }
    }

    @media(max-width:768px) {
      .sec {
        padding: 60px 24px;
      }

      .hero {
        padding: 80px 24px 80px;
        min-height: auto;
      }

      .hero-content {
        top: 30px;
      }

      .hero-globe-bg {
        width: min(500px, 90vw);
        height: min(500px, 90vw);
        bottom: -80px;
        z-index: 0;
      }

      .hero-squiggle {
        display: none;
      }

      .hero-arc {
        display: none;
      }

      .clutch-badge {
        display: none;
      }

