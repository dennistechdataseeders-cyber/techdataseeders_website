    .val-ico{width:50px;height:50px;border-radius:14px;background:linear-gradient(135deg,rgba(37,99,255,.12),rgba(37,99,255,.06));display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:all .3s;}
