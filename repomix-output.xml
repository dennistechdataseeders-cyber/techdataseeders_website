<script>
  // ============================================================
  // BLOG PAGE - FETCHES FROM NODE.JS API / MONGODB
  // ============================================================
  
  const API_URL = window.location.origin + '/api';
  
  // Icon mapping for blog cards
  const ICONS = {
    database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4.03 3-9 3S3 13.66 3 12"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>',
    activity: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    chart: '<path d="M3 21h18"/><path d="M7 21V10"/><path d="M12 21V4"/><path d="M17 21v-7"/>',
    doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>',
    globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>',
    star: '<path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8l-6.2 3.3L7 14.2l-5-4.9 6.9-1z"/>',
    bulb: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2v.3h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>',
    zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
    bar: '<rect x="4" y="4" width="4" height="16"/><rect x="12" y="10" width="4" height="10"/>'
  };

  // Gradient mapping
  const GRADIENTS = {
    blue: 'linear-gradient(135deg,#0d1b4b 0%,#1a4fd6 50%,#2563FF 100%)',
    green: 'linear-gradient(135deg,#064e3b 0%,#059669 50%,#10b981 100%)',
    purple: 'linear-gradient(135deg,#2e1065 0%,#5b21b6 50%,#7c3aed 100%)',
    magenta: 'linear-gradient(135deg,#4d1a3d 0%,#9d4edd 50%,#c77dff 100%)',
    teal: 'linear-gradient(135deg,#1a4d3d 0%,#2d9d6e 50%,#52b788 100%)',
    navy: 'linear-gradient(135deg,#0d1840 0%,#162050 60%,#2563FF 100%)'
  };

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function getGradient(post) {
    return GRADIENTS[post.gradient] || GRADIENTS.blue;
  }

  function getIcon(post) {
    return ICONS[post.icon] || ICONS.database;
  }

  function getPostUrl(slug) {
    return './post.html?slug=' + encodeURIComponent(slug);
  }

  function createCardHTML(post) {
    const artContent = post.heroImage
      ? '<img src="' + escapeHtml(post.heroImage) + '" alt="' + escapeHtml(post.title) + '" class="blog-art-img" loading="lazy">'
      : '<div class="blog-art-ico"><svg viewBox="0 0 24 24">' + getIcon(post) + '</svg></div>';
    
    const artStyle = post.heroImage ? '' : ' style="background:' + getGradient(post) + ';"';
    
    return '<a href="' + getPostUrl(post.slug) + '" class="blog-card">' +
      '<div class="blog-art"' + artStyle + '>' +
        artContent +
      '</div>' +
      '<div class="blog-body">' +
        '<span class="blog-cat">' + escapeHtml(post.category) + '</span>' +
        '<h3 class="blog-title">' + escapeHtml(post.title) + '</h3>' +
        '<p class="blog-exc">' + escapeHtml(post.excerpt) + '</p>' +
        '<div class="blog-foot">' +
          '<span class="blog-date">' + escapeHtml(post.date) + '</span>' +
          '<span class="blog-read">Read more <svg viewBox="0 0 14 14"><path d="M1 7h12M7 1l6 6-6 6"/></svg></span>' +
        '</div>' +
      '</div>' +
    '</a>';
  }

  async function fetchPosts() {
    try {
      const response = await fetch(API_URL + '/blog');
      const data = await response.json();
      
      if (data.success && data.data && data.data.length > 0) {
        return data.data;
      }
      return [];
    } catch (error) {
      console.error('Error fetching posts from API:', error);
      return [];
    }
  }

  function renderPosts(list) {
    const grid = document.getElementById('blogGrid');
    
    if (!list || !list.length) {
      grid.innerHTML = '<div class="bl-empty">No articles published yet.</div>';
      return;
    }

    // Sort by date (newest first)
    const sorted = list.slice().sort((a, b) => {
      return new Date(b.date) - new Date(a.date);
    });

    grid.innerHTML = sorted.map(createCardHTML).join('');
  }

  function setupFilters(posts) {
    document.querySelectorAll('.blog-filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.blog-filter-btn').forEach(function(b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');
        
        const cat = btn.getAttribute('data-cat');
        const cards = document.querySelectorAll('#blogGrid .blog-card');
        
        cards.forEach(function(card) {
          const catEl = card.querySelector('.blog-cat');
          if (cat === 'all' || (catEl && catEl.textContent.trim() === cat)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // ============================================================
  // MAIN EXECUTION - Fetch from API and render
  // ============================================================
  (async function() {
    const posts = await fetchPosts();
    renderPosts(posts);
    setupFilters(posts);
  })();
</script>

  <div class="stb" id="stb" onclick="window.scrollTo({top:0,behavior:'smooth'})">&#8593;</div>
  <script>
  (function(){
    var nav=document.getElementById('nav'),toggle=document.getElementById('navToggle');
    if(!nav)return;
    var drops=nav.querySelectorAll('.nl .has-drop');
    function closeDrops(except){drops.forEach(function(li){if(li!==except)li.classList.remove('open');});}
    drops.forEach(function(li){
      var link=li.querySelector(':scope > a');
      link.addEventListener('click',function(e){
        e.preventDefault();
        var willOpen=!li.classList.contains('open');
        closeDrops(li);
        li.classList.toggle('open',willOpen);
      });
    });
    document.addEventListener('click',function(e){if(!e.target.closest('.has-drop'))closeDrops(null);});
    if(toggle){
      toggle.addEventListener('click',function(){
        var open=nav.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded',open?'true':'false');
        if(!open)closeDrops(null);
      });
      nav.querySelectorAll('.nl a').forEach(function(a){
        if(a.parentElement.classList.contains('has-drop'))return;
        a.addEventListener('click',function(){nav.classList.remove('nav-open');toggle.setAttribute('aria-expanded','false');closeDrops(null);});
      });
      window.addEventListener('resize',function(){
        if(window.innerWidth>768){nav.classList.remove('nav-open');toggle.setAttribute('aria-expanded','false');closeDrops(null);}
      });
    }
    var stb=document.getElementById('stb');
    if(stb)window.addEventListener('scroll',function(){stb.classList.toggle('on',window.scrollY>400);});
    var navLogo=document.getElementById('navLogo');
    window.addEventListener('scroll',function(){
      var s=window.scrollY;
      nav.classList.toggle('dark',s>80);
      if(navLogo)navLogo.src=s>80?'../logo/TDS Logo Set/Tech DataSeeders Logo white.png':'../logo/Tech DataSeeders Logo.png';
    });
  })();
  
    /* ==== CURSOR ==== */
    (function() {
      var cd = document.getElementById('cd'), cr = document.getElementById('cr');
      if (!cd || !cr) return;
      var mx = 0, my = 0, rx = 0, ry = 0;
      document.addEventListener('mousemove', function(e) {
        mx = e.clientX; my = e.clientY;
        cd.style.left = mx + 'px'; cd.style.top = my + 'px';
      });
      (function loop() {
        rx += (mx - rx) * .12; ry += (my - ry) * .12;
        cr.style.left = rx + 'px'; cr.style.top = ry + 'px';
        requestAnimationFrame(loop);
      })();
      document.querySelectorAll('a,button').forEach(function(el) {
        el.addEventListener('mouseenter', function() { cd.style.width = cd.style.height = '12px'; cr.style.width = cr.style.height = '52px'; cr.style.opacity = '.45'; });
        el.addEventListener('mouseleave', function() { cd.style.width = cd.style.height = '8px'; cr.style.width = cr.style.height = '36px'; cr.style.opacity = '1'; });
      });
    })();
  </script>
