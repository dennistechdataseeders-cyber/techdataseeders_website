<file path="privacy.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Privacy Policy — TechDataSeeders</title>
  <link rel="icon" href="./images/tds-icon.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{--blue:#2563FF;--blue-dark:#1a4fd8;--black:#0a0a0a;--font-d:'Plus Jakarta Sans',sans-serif;--font-b:'Inter',sans-serif;}
    body{font-family:var(--font-b);background:#fff;color:var(--black);-webkit-font-smoothing:antialiased;}
    a{text-decoration:none;color:inherit;}

    /* NAV */
    .nav{position:fixed;top:0;left:0;right:0;height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 60px;background:rgba(255,255,255,.97);backdrop-filter:blur(14px);border-bottom:1px solid rgba(0,0,0,.07);z-index:100;}
    .nav-logo img{height:36px;}
    .nl{display:flex;align-items:center;gap:6px;list-style:none;}
    .nl a{font-size:14px;font-weight:500;color:#444;padding:8px 14px;border-radius:8px;transition:color .2s,background .2s;}
    .nl a:hover{color:var(--blue);}
    .has-drop{position:relative;}
    .has-drop>a span{font-size:10px;margin-left:3px;display:inline-block;transition:transform .25s;}
    .has-drop.open>a span{transform:rotate(180deg);}
    .nav-drop{position:absolute;top:calc(100% + 10px);left:0;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;box-shadow:0 18px 48px rgba(0,0,0,.12);padding:8px;min-width:220px;opacity:0;visibility:hidden;transform:translateY(8px);transition:all .22s;}
    .has-drop.open>.nav-drop{opacity:1;visibility:visible;transform:translateY(0);}
    .nav-drop a{display:block;padding:10px 14px;font-size:14px;color:#444;border-radius:8px;transition:background .15s,color .15s;}
    .nav-drop a:hover{background:#f4f6ff;color:var(--blue);}
    .nav-cta{background:var(--blue);color:#fff !important;padding:10px 22px;border-radius:100px;font-size:14px;font-weight:600;transition:all .25s;white-space:nowrap;}
    .nav-cta:hover{background:var(--blue-dark);transform:translateY(-1px);}
    .nav-toggle{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px;}
    .nav-toggle span{display:block;width:22px;height:2px;background:#222;border-radius:2px;transition:all .3s;}

    /* HERO */
    .page-hero{background:linear-gradient(150deg,#06091a 0%,#0d1840 60%,#162050 100%);padding:140px 80px 80px;position:relative;overflow:hidden;}
    .page-hero::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 55% 70% at 80% 120%,rgba(37,99,255,.28),transparent);}
    .page-hero-inner{position:relative;z-index:1;max-width:760px;}
    .page-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(37,99,255,.2);border:1px solid rgba(37,99,255,.4);color:rgba(255,255,255,.88);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:6px 16px;border-radius:100px;margin-bottom:24px;}
    .page-h1{font-family:var(--font-d);font-size:clamp(36px,5vw,58px);font-weight:800;color:#fff;line-height:1.06;letter-spacing:-.035em;margin-bottom:18px;}
    .page-meta{font-size:14px;color:rgba(255,255,255,.45);}

    /* CONTENT */
    .doc-wrap{max-width:800px;margin:0 auto;padding:72px 40px 96px;}
    .doc-section{margin-bottom:48px;}
    .doc-section:last-child{margin-bottom:0;}
    .doc-h2{font-family:var(--font-d);font-size:22px;font-weight:700;color:var(--black);margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid rgba(0,0,0,.07);}
    .doc-p{font-size:15.5px;line-height:1.85;color:#4a4a4a;margin-bottom:16px;}
    .doc-p:last-child{margin-bottom:0;}
    .doc-ul{margin:12px 0 16px 20px;display:flex;flex-direction:column;gap:9px;}
    .doc-ul li{font-size:15px;line-height:1.75;color:#4a4a4a;list-style:disc;}
    .doc-link{color:var(--blue);font-weight:500;}
    .doc-link:hover{text-decoration:underline;}
    .doc-highlight{background:#f4f7ff;border-left:3px solid var(--blue);border-radius:0 10px 10px 0;padding:18px 22px;margin:20px 0;}
    .doc-highlight p{font-size:14.5px;line-height:1.75;color:#444;}

