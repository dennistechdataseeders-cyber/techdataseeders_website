<script>
  /* CURSOR */
  const cd = document.getElementById('cd'), cr = document.getElementById('cr');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; cd.style.left = mx + 'px'; cd.style.top = my + 'px'; });
  (function loop() { rx += (mx - rx) * .12; ry += (my - ry) * .12; cr.style.left = rx + 'px'; cr.style.top = ry + 'px'; requestAnimationFrame(loop); })();
  document.querySelectorAll('a,button').forEach(el => {
    el.addEventListener('mouseenter', () => { cd.style.width = cd.style.height = '12px'; cr.style.width = cr.style.height = '52px'; cr.style.opacity = '.45'; });
    el.addEventListener('mouseleave', () => { cd.style.width = cd.style.height = '8px'; cr.style.width = cr.style.height = '36px'; cr.style.opacity = '1'; });
  });

  /* NAVBAR SCROLL */
  const nav = document.getElementById('nav'), navLogo = document.getElementById('navLogo'), stb = document.getElementById('stb');
  window.addEventListener('scroll', () => {
    const s = window.scrollY;
    nav.classList.toggle('dark', s > 80);
    navLogo.src = s > 80 ? './logo/TDS Logo Set/Tech DataSeeders Logo white.png' : './logo/Tech DataSeeders Logo.png';
    stb.classList.toggle('on', s > 400);
  });

  /* MOBILE NAV */
  (function () {
    var toggle = document.getElementById('navToggle');
    var drops = nav.querySelectorAll('.has-drop');
    drops.forEach(function (li) {
      var link = li.querySelector(':scope > a');
      link.addEventListener('click', function (e) {
        if (window.innerWidth <= 960) { e.preventDefault(); li.classList.toggle('open'); }
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.has-drop')) drops.forEach(function (li) { li.classList.remove('open'); });
    });
    if (toggle) {
      toggle.addEventListener('click', function () {
        var open = nav.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open) drops.forEach(function (li) { li.classList.remove('open'); });
      });
      nav.querySelectorAll('.nl a:not(.has-drop a ~ a)').forEach(function (a) {
        if (a.closest('.has-drop') && a === a.closest('.has-drop').querySelector(':scope > a')) return;
        a.addEventListener('click', function () { nav.classList.remove('nav-open'); toggle.setAttribute('aria-expanded', 'false'); });
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 960) { nav.classList.remove('nav-open'); toggle.setAttribute('aria-expanded', 'false'); drops.forEach(function (li) { li.classList.remove('open'); }); }
      });
    }
  })();
</script>
