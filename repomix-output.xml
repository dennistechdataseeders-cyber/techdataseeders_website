<file path="about.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>About Us   Techdataseeders</title>
  <link rel="icon" href="./images/tds-icon.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{--blue:#2563FF;--blue-dark:#1a4fd8;--black:#0a0a0a;--font-d:'Plus Jakarta Sans',sans-serif;--font-b:'Inter',sans-serif;}
    body{font-family:var(--font-b);background:#fff;color:var(--black);-webkit-font-smoothing:antialiased;cursor:none;}
    a{text-decoration:none;color:inherit;}

    /* CURSOR */
    .cur-dot{width:8px;height:8px;background:var(--blue);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .15s,height .15s;}
    .cur-ring{width:36px;height:36px;border:1.5px solid var(--blue);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .2s,height .2s,opacity .2s;}

    /* NAV */
    .nav{position:fixed;top:0;left:0;right:0;height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 60px;background:rgba(255,255,255,.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(0,0,0,.07);z-index:100;transition:background .3s,border-color .3s;}
    .nav.dark{background:#0a0a0a;border-bottom-color:rgba(255,255,255,.08);}
    .nav-logo img{height:40px;transition:opacity .3s;}
    .nl{display:flex;align-items:center;gap:6px;list-style:none;}
    .nl a{font-size:14px;font-weight:500;color:#444;padding:8px 14px;border-radius:8px;transition:color .2s,background .2s;position:relative;}
    .nl a:hover{color:var(--blue);}
    .nav.dark .nl a{color:rgba(255,255,255,.75);}
    .nav.dark .nl a:hover{color:#fff;}
    .has-drop{position:relative;}
    .has-drop>a span{font-size:10px;margin-left:3px;display:inline-block;transition:transform .25s;}
    .has-drop.open>a span{transform:rotate(180deg);}
    .nav-drop{position:absolute;top:calc(100% + 10px);left:0;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;box-shadow:0 18px 48px rgba(0,0,0,.12);padding:8px;min-width:220px;opacity:0;visibility:hidden;transform:translateY(8px);transition:all .22s;}
    .has-drop.open>.nav-drop{opacity:1;visibility:visible;transform:translateY(0);}
    .nav-drop a{display:block;padding:10px 14px;font-size:14px;color:#444;border-radius:8px;transition:background .15s,color .15s;}
    .nav-drop a:hover{background:#f4f6ff;color:var(--blue);}
    .nav-cta{background:var(--blue);color:#fff !important;padding:10px 22px;border-radius:100px;font-size:14px;font-weight:600;transition:all .25s;white-space:nowrap;}
    .nav-cta:hover{background:var(--blue-dark);transform:translateY(-1px);}
    .nav-toggle{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px;}
    .nav-toggle span{display:block;width:22px;height:2px;background:#222;border-radius:2px;transition:all .3s;}
    .nav.dark .nav-toggle span{background:#fff;}
    .nav-open .nav-toggle span:nth-child(1){transform:translateY(7px) rotate(45deg);}
    .nav-open .nav-toggle span:nth-child(2){opacity:0;}
    .nav-open .nav-toggle span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

    /* BREADCRUMB */
    .crumb-bar{position:absolute;top:92px;left:0;right:0;padding:0 80px;z-index:3;display:flex;align-items:center;gap:18px;flex-wrap:wrap;}
    .back-link{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:rgba(255,255,255,.85);background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:8px 16px;border-radius:100px;transition:all .25s;backdrop-filter:blur(6px);}
    .back-link:hover{background:rgba(255,255,255,.2);color:#fff;transform:translateX(-2px);}
    .back-link svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
    .breadcrumb{display:flex;align-items:center;gap:9px;font-size:13px;color:rgba(255,255,255,.6);flex-wrap:wrap;}
    .breadcrumb a{color:rgba(255,255,255,.72);transition:color .2s;}
    .breadcrumb a:hover{color:#fff;}
    .breadcrumb .sep{color:rgba(255,255,255,.35);}
    .breadcrumb .current{color:#fff;font-weight:600;}

    /* HERO */
    .ind-hero{min-height:520px;padding:180px 80px 100px;position:relative;overflow:hidden;display:flex;align-items:flex-end;}
    .ind-hero-bg{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1400&q=80');background-size:cover;background-position:center;}
    .ind-hero-overlay{position:absolute;inset:0;background:linear-gradient(150deg,rgba(6,6,18,.92) 0%,rgba(37,99,255,.5) 100%);}
    .ind-hero-content{position:relative;z-index:2;max-width:780px;}
    .ind-hero-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(37,99,255,.2);border:1px solid rgba(37,99,255,.45);color:rgba(255,255,255,.88);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:6px 16px;border-radius:100px;margin-bottom:28px;}
    .ind-hero-h1{font-family:var(--font-d);font-size:clamp(42px,6vw,68px);font-weight:800;color:#fff;line-height:1.05;letter-spacing:-.035em;margin-bottom:22px;}
    .ind-hero-sub{font-size:18px;line-height:1.75;color:rgba(255,255,255,.68);max-width:580px;}

    /* INTRO / STORY */
    .sec-intro{padding:90px 80px 80px;}
    .intro-kicker{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;}
    .intro-kicker::before{content:'';width:20px;height:2px;background:var(--blue);border-radius:2px;}
    .intro-h{font-family:var(--font-d);font-size:clamp(28px,3vw,40px);font-weight:700;line-height:1.14;letter-spacing:-.025em;color:var(--black);margin-bottom:22px;}
    .intro-h em{font-style:italic;color:var(--blue);}
    .intro-p{font-size:17px;line-height:1.85;color:#555;margin-bottom:20px;}
    .intro-p:last-child{margin-bottom:0;}

    /* STATS BAND */
    .sec-stats{padding:0 80px 90px;}
    .stats-band{background:linear-gradient(140deg,#06091a 0%,#0d1840 55%,#162050 100%);border-radius:28px;padding:56px 48px;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;position:relative;overflow:hidden;}
    .stats-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 50% 80% at 80% 120%,rgba(37,99,255,.35),transparent);}
    .stat{position:relative;z-index:1;text-align:center;}
    .stat-n{font-family:var(--font-d);font-size:clamp(32px,4vw,46px);font-weight:800;color:#fff;line-height:1;letter-spacing:-.02em;}
    .stat-n span{color:rgba(96,165,250,.95);}
    .stat-l{font-size:13.5px;color:rgba(255,255,255,.55);margin-top:10px;}

    /* MISSION & VISION */
    .sec-mv{padding:0 80px 90px;}
    .mv-head{max-width:640px;margin-bottom:48px;}
    .mv-kicker{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin-bottom:16px;}
    .mv-kicker::before{content:'';width:20px;height:2px;background:var(--blue);border-radius:2px;}
    .mv-h{font-family:var(--font-d);font-size:clamp(26px,3vw,40px);font-weight:700;line-height:1.12;letter-spacing:-.025em;color:var(--black);}
    .mv-h em{font-style:italic;color:var(--blue);}
    .mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
    .mv-card{background:#f8f9fb;border:1px solid rgba(0,0,0,.07);border-radius:22px;padding:40px;transition:all .35s cubic-bezier(.16,1,.3,1);}
    .mv-card:hover{border-color:rgba(37,99,255,.22);box-shadow:0 18px 50px rgba(37,99,255,.08);transform:translateY(-5px);}
    .mv-ico{width:54px;height:54px;border-radius:15px;background:linear-gradient(135deg,rgba(37,99,255,.12),rgba(37,99,255,.06));display:flex;align-items:center;justify-content:center;margin-bottom:22px;transition:all .3s;}
    .mv-ico svg{width:26px;height:26px;stroke:var(--blue);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:stroke .3s;}
